@* This Razor view displays and edits the admin profile page. *@
@model WebApp.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<h1>Admin Profile</h1>

<div class="card p-4 mt-3">
    <input type="hidden" id="userId" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Username</label>
        <input class="form-control" value="@Model.Username" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" id="email" value="@Model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">First Name</label>
        <input class="form-control" id="firstName" value="@Model.FirstName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Last Name</label>
        <input class="form-control" id="lastName" value="@Model.LastName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Phone Number</label>
        <input class="form-control" id="phoneNumber" value="@Model.PhoneNumber" />
    </div>

    <button class="btn btn-primary" onclick="updateProfile()">Save Changes</button>

    <div id="message" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        async function updateProfile() {
            const dto = {
                id: parseInt(document.getElementById("userId").value),
                email: document.getElementById("email").value,
                firstName: document.getElementById("firstName").value,
                lastName: document.getElementById("lastName").value,
                phoneNumber: document.getElementById("phoneNumber").value
            };
            //=============================AJAX========================================
            const response = await fetch("/Profile/UpdateProfile", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(dto)
            });

            const message = document.getElementById("message");

            if (response.ok) {
                const data = await response.json();
                message.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
            } else {
                const error = await response.text();
                message.innerHTML = `<div class="alert alert-danger">${error}</div>`;
            }
        }
    </script>
}